# Default is the offline simulator; nothing needs to be set to try the server.
# To call the real BioNeMo NIMs, uncomment and fill in:
# BIONEMO_BACKEND=live
# NGC_API_KEY=nvapi-xxxxxxxx          # free key at https://build.nvidia.com
# BIONEMO_BASE_URL=https://health.api.nvidia.com/v1   # or a self-hosted NIM base URL
